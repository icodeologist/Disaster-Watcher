      "roundness": null,
      "seed": 1029,
      "version": 1,
      "versionNonce": 1029,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Core invariants\n\nAccepted report is durable before it becomes background work.\n\nDelivery row is durable before its ID is published.\n\nEmail retry uses idempotency key: job/user.\n\nChannel close order follows pipeline order.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 183,
      "containerId": null,
      "originalText": "Core invariants\n\nAccepted report is durable before it becomes background work.\n\nDelivery row is durable before its ID is published.\n\nEmail retry uses idempotency key: job/user.\n\nChannel close order follows pipeline order.",
      "lineHeight": 1.25
    },
