      "y": 1170,
      "width": 996,
      "height": 96,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1027,
      "version": 1,
      "versionNonce": 1027,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Graceful shutdown control flow\n\nSIGINT/SIGTERM -> http.Server.Shutdown stops new HTTP requests and waits active handlers -> wait recovery sender -> close verificationChannel and wait -> close reportsChannel and wait -> close deliveryChannel and wait -> close retryDeliveryChannel and wait -> close deadLetterChannel\n\nSecond signal or deadline cancels worker context; unfinished durable work is recovered on restart.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 91,
      "containerId": null,
      "originalText": "Graceful shutdown control flow\n\nSIGINT/SIGTERM -> http.Server.Shutdown stops new HTTP requests and waits active handlers -> wait recovery sender -> close verificationChannel and wait -> close reportsChannel and wait -> close deliveryChannel and wait -> close retryDeliveryChannel and wait -> close deadLetterChannel\n\nSecond signal or deadline cancels worker context; unfinished durable work is recovered on restart.",
      "lineHeight": 1.25
    },
